DEXT_SERVER_PORT=8080

DEXT_DB_SERVER=localhost
DEXT_DB_PORT=5432
DEXT_DB_DATABASE=enterprise
DEXT_DB_USERNAME=app_user
DEXT_DB_PASSWORD=change-me
DEXT_DB_CHARSET=UTF8
# Optional native client override, e.g. C:/PostgreSQL/bin/libpq.dll
DEXT_DB_VENDORLIB=

DEXT_JWT_SECRET=replace-with-a-secret-at-least-32-characters-long
DEXT_JWT_ISSUER=dext-enterprise-starter
DEXT_JWT_AUDIENCE=dext-enterprise-api
DEXT_DEV_ADMIN_USERNAME=admin
DEXT_DEV_ADMIN_PASSWORD=change-me-now
